{
  "name": "saras-dictionary",
  "version": "26.4.6",
  "description": "SARAS — The Windows Dictionary App for Curious Readers",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:appx": "electron-builder --win appx --publish never",
    "release": "electron-builder --publish always"
  },
  "author": "SARAS",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.saras.dictionary",
    "productName": "SARAS",
    "publish": {
      "provider": "generic",
      "url": "https://storage.googleapis.com/saras-downloadable-2026/"
    },
    "win": {
      "icon": "assets/lotus_coin_v2.ico",
      "target": ["nsis", "appx"]
    },
    "appx": {
      "identityName": "VamsiKrishnaSurisetti.SARAS",
      "publisher": "CN=4E2E9B30-9FC1-460B-BD7F-5F39984AF76F",
      "publisherDisplayName": "VamsiKrishna Surisetti",
      "displayName": "SARAS",
      "applicationId": "SARAS"
    },
    "extraResources": [
      {
        "from": "../dist/Saras.exe",
        "to": "Saras.exe"
      },
      {
        "from": "../Dictionary.db",
        "to": "Dictionary.db"
      }
    ],
    "extraFiles": [
      {
        "from": "assets",
        "to": "resources/assets"
      }
    ]
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3"
  }
}