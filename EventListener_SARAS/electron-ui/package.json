{
  "name": "saras-dictionary",
  "version": "1.0.3",
  "description": "SARAS — The Windows Dictionary App for Curious Readers",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist":  "electron-builder --publish never",
    "release": "electron-builder --publish always"
  },
  "author": "SARAS",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.saras.dictionary",
    "productName": "SARAS",
    "publish": {
      "provider": "generic",
      "url": "https://storage.googleapis.com/saras-downloadable-2026/"
    },
    "win": {
      "icon": "assets/lotus_coin_v2.ico",
      "target": "nsis"
    },
    "extraResources": [
      {
        "from": "../dist/Saras.exe",
        "to": "Saras.exe"
      },
      {
        "from": "../Dictionary.db",
        "to": "Dictionary.db"
      }
    ],
    "extraFiles": [
      {
        "from": "assets",
        "to": "resources/assets"
      }
    ]
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3"
  }
}